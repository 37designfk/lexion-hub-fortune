---
const base = import.meta.env.BASE_URL
---

<footer class="border-t border-white/5 py-8 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <img
      src="https://fortune.lexionhub.com/wp-content/uploads/2025/12/Lexion-Hub-Fortune-White.png"
      alt="Lexion Hub Fortune"
      class="mx-auto mb-4 h-7 w-auto opacity-40"
    />
    <div class="flex items-center justify-center gap-4 mb-4">
      <a href={`${base}/terms`} class="text-xs text-white/30 hover:text-white/50 transition-colors font-sans">利用規約</a>
      <span class="text-white/10">|</span>
      <a href={`${base}/privacy`} class="text-xs text-white/30 hover:text-white/50 transition-colors font-sans">プライバシーポリシー</a>
    </div>
    <p class="text-[11px] text-white/20 font-sans">&copy; Lexion Hub Fortune / 株式会社37Design</p>
  </div>
</footer>
