---
import SectionHeader from '../ui/SectionHeader.astro'

const benefits = [
  { num: '1', title: '行動の傾向', desc: 'どんな場面で力を発揮しやすいか' },
  { num: '2', title: '無理が出やすい場面', desc: '消耗しがちなパターンを事前に把握' },
  { num: '3', title: '判断の癖', desc: '迷いやすい状況と、その傾向の原因' },
  { num: '4', title: '俯瞰レポート', desc: '自分の選び方を客観的に見直す材料' },
]

const lineUrl = 'https://bysfl175.autosns.app/line'
---

<section class="section-dark py-20 sm:py-28 px-4">
  <div class="max-w-4xl mx-auto">
    <SectionHeader label="Benefit" title="診断でわかること" />

    <div class="grid sm:grid-cols-2 gap-5 sm:gap-6">
      {benefits.map((b, i) => (
        <div class:list={['card-glass-strong rounded-2xl p-6 sm:p-8 reveal', `reveal-delay-${i + 1}`]}>
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-xl bg-brand-gold/10 flex items-center justify-center text-brand-gold font-serif font-bold text-lg">
              {b.num}
            </span>
            <div>
              <h3 class="font-serif text-base sm:text-lg font-semibold text-white/90 mb-2">{b.title}</h3>
              <p class="text-xs sm:text-sm text-white/50 leading-relaxed font-sans">{b.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Benefit後のマイクロCTA -->
    <div class="reveal reveal-delay-4 text-center mt-12 pt-8 border-t border-brand-gold/10">
      <p class="text-sm text-white/50 font-sans mb-4">
        これらの傾向を、たった<span class="text-brand-gold font-medium">1〜2分の入力</span>で確認できます。
      </p>
      <a
        href={lineUrl}
        class="cta-btn cta-pulse inline-block text-base px-8 py-4 sm:py-5 w-full sm:w-auto max-w-md mx-auto"
      >
        ＼ 無料で診断 ／ 自分のレポートを見てみる
      </a>
      <p class="text-[11px] text-white/25 mt-2 font-sans">合わなければいつでもブロック解除できます</p>
    </div>
  </div>
</section>
