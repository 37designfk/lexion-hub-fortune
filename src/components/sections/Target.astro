---
import SectionHeader from '../ui/SectionHeader.astro'
import CheckIcon from '../ui/CheckIcon.astro'

const items = [
  '占いを過信せず、参考情報として使いたい',
  '感覚だけでなく、整理された視点も取り入れたい',
  '判断の軸を一度見直してみたい',
  '同じ選択パターンを繰り返している気がする',
  '決断のたびに必要以上に消耗してしまう',
  '自分の行動を少し距離を置いて見てみたい',
  '人に合わせすぎてしまう場面が多い',
  '正解より「考えるための材料」がほしい',
]
---

<section class="section-gradient py-20 sm:py-28 px-4">
  <div class="max-w-3xl mx-auto">
    <SectionHeader label="For You" title="こんな方に向いています" />

    <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
      {items.map((item, i) => {
        const delay = Math.min(Math.floor(i / 2) + 1, 4)
        return (
          <div class:list={['flex items-start gap-3 reveal', `reveal-delay-${delay}`]}>
            <span class="flex-shrink-0 mt-0.5 w-6 h-6 rounded-full bg-brand-gold/10 flex items-center justify-center">
              <CheckIcon />
            </span>
            <p class="text-sm text-white/65 font-sans leading-relaxed">{item}</p>
          </div>
        )
      })}
    </div>
  </div>
</section>
