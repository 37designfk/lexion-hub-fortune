---
const lineUrl = 'https://bysfl175.autosns.app/line'
---

<div class="sticky-cta" id="stickyCta">
  <div class="bg-brand-line/95 backdrop-blur-sm shadow-[0_-4px_24px_rgba(6,199,85,0.2)]">
    <a href={lineUrl} class="flex items-center justify-center gap-3 py-3.5 sm:py-4 px-4 text-white font-sans">
      <span class="text-[11px] text-white/70 hidden sm:inline">10,000件以上の実績</span>
      <span class="hidden sm:inline text-white/40">|</span>
      <span class="font-bold text-sm sm:text-base">無料で診断する</span>
      <svg class="w-4 h-4 animate-bounce-x" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
<div class="h-14 sm:h-16" id="stickySpacerBottom"></div>
